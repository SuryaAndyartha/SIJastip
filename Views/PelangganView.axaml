<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JastipApp.Views.PelangganView">

  <Grid RowDefinitions="Auto,Auto,*">
    <StackPanel Spacing="2" Margin="0,0,0,14">
      <TextBlock Text="{Binding JudulHalaman}" Classes="h1" />
      <TextBlock Text="{Binding Subjudul}" Classes="k" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,10,Auto" Margin="0,0,0,12">
      <TextBox Text="{Binding SearchText}" Watermark="Cari nama, username, atau kontak" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding FilterPeran}" SelectedItem="{Binding SelectedPeran}"
                MinWidth="160" IsVisible="{Binding IsAdmin}" />
    </Grid>

    <Border Grid.Row="2" Classes="card" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Background="{DynamicResource BgSubtle}" Padding="16,10"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,140,90,80,130,130,110,130">
            <TextBlock Text="NAMA" Classes="th" />
            <TextBlock Grid.Column="1" Text="KONTAK" Classes="th" />
            <TextBlock Grid.Column="2" Text="PERAN" Classes="th" />
            <TextBlock Grid.Column="3" Text="PESANAN" Classes="th" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Text="TOTAL BELANJA" Classes="th" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="5" Text="SISA TAGIHAN" Classes="th" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="6" Text="TERAKHIR" Classes="th" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="7" Text="AKUN" Classes="th" HorizontalAlignment="Right" />
          </Grid>
        </Border>

        <Panel Grid.Row="1">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Baris}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="16,10" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,140,90,80,130,130,110,130">
                      <StackPanel Margin="0,0,10,0">
                        <TextBlock Classes="v" FontWeight="SemiBold">
                          <Run Text="{Binding Nama}" />
                          <Run Text="{Binding Username}" FontWeight="Normal" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Alamat}" Classes="k" FontSize="11" IsVisible="{Binding AdaAlamat}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Kontak}" Classes="v" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding PeranText}" Classes="v" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding JumlahPesanan}" Classes="v" FontSize="13"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding TotalBelanja}" Classes="v" FontSize="13"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="{Binding SisaTagihan}" Classes="v" FontSize="13"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="6" Text="{Binding TerakhirPesan}" Classes="k" FontSize="12"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6"
                                  HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusAkun}" Classes="k" FontSize="12" VerticalAlignment="Center"
                                   IsVisible="{Binding !BisaUbahAkun}" />
                        <Button Classes="ghost small" Content="{Binding TombolAkun}"
                                Command="{Binding UbahStatusAkunCommand}" IsVisible="{Binding BisaUbahAkun}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="Belum ada data." Classes="k" HorizontalAlignment="Center" Margin="0,30,0,0"
                     IsVisible="{Binding Kosong}" />
        </Panel>

        <Border Grid.Row="2" Padding="16,10" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
          <TextBlock Text="{Binding Ringkasan}" Classes="k" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
